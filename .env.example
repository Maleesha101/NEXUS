APP_NAME=NEXUS
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=nexus_lab_password

SESSION_LAB_MODE=vulnerable

# Intentionally vulnerable laboratory switches.
# Never enable these settings in a production deployment.
VULN_PREDICTABLE_SESSION=true
VULN_SESSION_FIXATION=true
VULN_NO_ROTATION_AFTER_LOGIN=true
VULN_LOGOUT_NOT_INVALIDATE=true
VULN_LONG_LIVED_SESSION=true
VULN_MISSING_HTTPONLY=true
VULN_WEAK_SAMESITE=true

SESSION_LIFETIME=120
